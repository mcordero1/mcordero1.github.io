# Sin DATABASE_URL se usa SQLite local en data/profile.db.
# Las variables deben exportarse en el shell; este archivo no se carga automáticamente.
# DATABASE_URL=postgresql+psycopg://USER:PASSWORD@HOST:5432/DBNAME
# En Render es obligatoria una conexión PostgreSQL con TLS. Copiar la URL de
# Neon directamente al campo secreto DATABASE_URL, sin guardarla en este archivo.
# Ejemplo sin credenciales reales:
# DATABASE_URL=postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require
