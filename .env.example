# =============================================================================
# VARIABLES DE ENTORNO — mcordero1.github.io
# =============================================================================
# Este archivo es solo documentación. No se carga automáticamente.
# Para desarrollo local: copiar como ".env" y completar los valores reales.
# Para producción (Render): cargar cada variable en el panel de Environment.
# NUNCA commitear el archivo ".env" con valores reales al repositorio.
# =============================================================================

# -----------------------------------------------------------------------------
# BASE DE DATOS
# -----------------------------------------------------------------------------
# Sin DATABASE_URL se usa SQLite local en data/profile.db (solo desarrollo).
# En Render es obligatoria una conexión PostgreSQL con TLS.
# Copiar la URL de Neon directamente al campo secreto en Render.
# DATABASE_URL=postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require

# -----------------------------------------------------------------------------
# PORTFOLIO HEALTH — MÓDULO DE ANÁLISIS DE CARTERAS
# -----------------------------------------------------------------------------

# Proveedor de IA: actualmente solo "gemini" está soportado.
AI_PROVIDER=gemini

# API Key de Google Gemini (free tier disponible).
# Obtener en: https://aistudio.google.com/ → Get API key → Create API key
# La key empieza con "AIza".
# En desarrollo: descomentar y pegar el valor aquí (solo en .env local, nunca en .env.example).
# GEMINI_API_KEY=AIzaSy...

# Límite de tokens totales por sesión de análisis (previene costos excesivos).
# Valor sugerido para free tier: 10000
AI_MAX_TOKENS_PER_SESSION=10000

# Tasa libre de riesgo anualizada para el cálculo del Sharpe Ratio (en decimal).
# Referencia: T-Bill 3m USD ≈ 0.05 | Leliq/BCRA para carteras en ARS.
RISK_FREE_RATE=0.05

# Origen permitido para CORS (dominio del frontend estático en GitHub Pages).
# En desarrollo usar: http://localhost:8001
PORTFOLIO_CORS_ORIGIN=https://mcordero1.github.io

# Entorno de ejecución. Render lo setea automáticamente a "true".
# No modificar manualmente.
# RENDER=true
